import jinja2
from jinja2 import Environment
from jinja2.loaders import FileSystemLoader
from pathlib import Path


def create_templates(directory):
    env = Environment(
        loader=FileSystemLoader([directory]),
        autoescape=True,
    )
    return env


class TemplateResponse:
    def __init__(self, env: Environment):
        self.env = env

    def __call__(self, request, name: str, context: dict = None, status_code: int = 200):
        from fastapi.responses import HTMLResponse
        template = self.env.get_template(name)
        context = context or {}
        context["request"] = request
        rendered = template.render(**context)
        return HTMLResponse(rendered, status_code=status_code)


def create_templates_with_response(directory):
    env = create_templates(directory)
    return TemplateResponse(env)