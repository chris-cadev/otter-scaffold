{%- if include_rate_limiting %}

@app.exception_handler(RateLimitExceeded)
async def rate_limit_handler(request: Request, exc: RateLimitExceeded):
    security_logger.warning(f"Rate limit exceeded: {request.client.host}")
    return JSONResponse(
        status_code=429, content={"detail": "Too many requests. Please try again later."}
    )

{%- endif %}

{%- if include_error_pages %}

@app.exception_handler(HTTPException)
async def http_exception_handler(request: Request, exc: HTTPException):
    if exc.status_code == 404:
        return error_templates.TemplateResponse(request, "404.html", {"request": request})
    elif exc.status_code == 400:
        return error_templates.TemplateResponse(request, "400.html", {"request": request})
    elif exc.status_code == 403:
        return error_templates.TemplateResponse(request, "403.html", {"request": request})
    elif exc.status_code == 422:
        return error_templates.TemplateResponse(request, "422.html", {"request": request})
    elif exc.status_code == 500:
        return error_templates.TemplateResponse(request, "500.html", {"request": request})
    return JSONResponse(status_code=exc.status_code, content={"detail": exc.detail})


@app.exception_handler(Exception)
async def general_exception_handler(request: Request, exc: Exception):
    logging.error(f"Unhandled exception: {exc}", exc_info=True)
    return error_templates.TemplateResponse(request, "500.html", {"request": request})


async def _render_service_unavailable(request: Request) -> JSONResponse:
    if request.headers.get("hx-request") == "true":
        return JSONResponse(
            status_code=503,
            content={
                "error": "service_unavailable",
                "message": "The database is unavailable. Please wait and try again.",
            },
        )
    return error_templates.TemplateResponse(
        request, "service_unavailable.html", {"request": request}, status_code=503
    )


@app.exception_handler(asyncio.TimeoutError)
async def timeout_exception_handler(request: Request, exc: asyncio.TimeoutError):
    logging.error(f"Database timeout: {exc}", exc_info=True)
    return await _render_service_unavailable(request)

{%- if database == 'postgres' %}
try:
    import asyncpg

    @app.exception_handler(asyncpg.PostgresConnectionError)
    async def postgres_connection_handler(request: Request, exc: asyncpg.PostgresConnectionError):
        logging.error(f"PostgreSQL connection error: {exc}", exc_info=True)
        return await _render_service_unavailable(request)

    @app.exception_handler(asyncpg.CannotConnectNowError)
    async def cannot_connect_handler(request: Request, exc: asyncpg.CannotConnectNowError):
        logging.error(f"PostgreSQL cannot connect: {exc}", exc_info=True)
        return await _render_service_unavailable(request)

    @app.exception_handler(asyncpg.ConnectionDoesNotExistError)
    async def connection_does_not_exist_handler(
        request: Request, exc: asyncpg.ConnectionDoesNotExistError
    ):
        logging.error(f"PostgreSQL connection does not exist: {exc}", exc_info=True)
        return await _render_service_unavailable(request)

    @app.exception_handler(asyncpg.ConnectionFailureError)
    async def connection_failure_handler(request: Request, exc: asyncpg.ConnectionFailureError):
        logging.error(f"PostgreSQL connection failure: {exc}", exc_info=True)
        return await _render_service_unavailable(request)
except ImportError:
    pass
