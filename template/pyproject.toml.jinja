[project]
authors = [
  {name = "{{ author_name }}", email = "{{ author_email }}"},
]
description = "{{ project_name }}"
license = {text = "MIT"}
name = "{{ package_name }}"
readme = "README.md"
requires-python = ">=3.12"
version = "0.1.0"

dependencies = [
  "fastapi[standard]>=0.129.2",
  "jinja2>=3.1.6",
  "pyyaml>=6.0",
  "markdown>=3.0",
  "sqlalchemy[asyncio]>=2.0",
  {% if database == 'sqlite' %}
  "aiosqlite>=0.20",
  {% elif database == 'postgres' %}
  "asyncpg>=0.30",
  {% endif %}
  {% if include_auth %}
  "pyjwt>=2.11.0",
  {% endif %}
  "uvicorn[standard]>=0.41.0",
  "python-dotenv>=1.2.1",
  "minify-html>=0.15.0",
  "humanize>=4.15.0",
  {% if include_alembic %}
  "alembic>=1.18.4",
  {% endif %}
]
[project.optional-dependencies]
test = [
  "pytest>=8.0",
  "pytest-asyncio>=0.23",
  "pytest-cov>=5.0",
]

[build-system]
build-backend = "pdm.backend"
requires = ["pdm-backend"]

[tool.pdm.scripts]
client_install = "bun install"
client_watch = "bun run watch"
dev = "fastapi dev src/{{ package_name }}/app.py"
migration_create = "alembic revision --autogenerate -m"
post_install = {composite = ["cp_env", "migrate", "client_install", "build"]}

cp_env = {shell = 'cp -n .env.example .env'}
clean = {shell = 'find . -type d -name "__pycache__" -exec rm -r {} + && rm -rf static .venv node_modules'}
drop_db = "rm -f {{ package_name }}.db"

build = "bun run build"
migrate = "alembic upgrade head"

prod = "uvicorn {{ package_name }}.app:app --host 0.0.0.0 --port {{ port }}"

test = "pytest -v --cov={{ package_name }} --cov-report=term-missing"

watch = "bun run watch"

[tool.pdm]
distribution = true

[dependency-groups]
dev = [
  "python-dotenv>=1.2.2",
]
