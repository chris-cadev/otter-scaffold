[project]
authors = [
  {name = "{{ author_name }}", email = "{{ author_email }}"},
]
description = "{{ project_name }}"
license = {text = "MIT"}
name = "{{ package_name }}"
readme = "README.md"
requires-python = ">=3.12"
version = "0.1.0"

dependencies = [
  "fastapi[standard]>=0.129.2",
  "jinja2>=3.1.6",
  "pyyaml>=6.0",
  "markdown>=3.0",
  "sqlalchemy[asyncio]>=2.0",
  {%- if database == 'sqlite' -%}
  "aiosqlite>=0.20",
  {%- elif database == 'postgres' -%}
  "asyncpg>=0.30",
  "psycopg2-binary>=2.9",
  {%- endif -%}
  {%- if include_auth -%}
  "pyjwt>=2.11.0",
  {%- endif -%}
  "uvicorn[standard]>=0.41.0",
  "python-dotenv>=1.2.1",
  "minify-html>=0.15.0",
  "humanize>=4.15.0",
  "pydantic[email]>=2.0",
  {%- if include_rate_limiting -%}
  "slowapi>=0.1.9",
  "email-validator>=2.3.0",
  {%- endif -%}
  {%- if include_alembic -%}
  "alembic>=1.18.4",
  {%- endif -%}
]
[project.optional-dependencies]
test = [
  "pytest>=8.0",
  "pytest-asyncio>=0.23",
  "pytest-cov>=5.0",
  "pytest-watch>=4.2",
]

[build-system]
build-backend = "pdm.backend"
requires = ["pdm-backend"]

[tool.pdm.scripts]
client_install = "bun install"
client_watch = "bun run watch"
dev = "fastapi dev src/{{ package_name }}/app.py"
migration_create = "alembic revision --autogenerate -m"
post_install = {composite = ["cp_env", "client_install", "build"]}

cp_env = {shell = 'cp -n .env.example .env'}
clean = {shell = 'find . -type d -name "__pycache__" -exec rm -r {} + && rm -rf static .venv node_modules'}
drop_db = "rm -f {{ package_name }}.db"

db_up = "docker compose -p {{ package_name }} up -d db"
db_down = "docker compose -p {{ package_name }} down db"
db_logs = "docker compose -p {{ package_name }} logs -f db"

backup = {shell = "mkdir -p backups && docker compose -p {{ package_name }} run --rm -v \"$(pwd)/backups:/backups\" db sh -c 'pg_dump -h db -U postgres -Fc app -f /backups/app_$(date +%Y%m%d_%H%M%S).dump'"}
backup_list = {shell = "ls -la ./backups/"}
restore = {cmd = ["bash", "-c", "docker compose -p {{ package_name }} run --rm -v \"$(pwd)/backups:/backups\" db pg_restore -h db -U postgres -C -d postgres --clean --if-exists \"/backups/$1\"", "_", "{args}"]}

build = "bun run build"
dc_build = "docker compose -p {{ package_name }} build"
dc_up = "docker compose -p {{ package_name }} up -d --force-recreate"
dc_down = "docker compose -p {{ package_name }} down"
dc_migrate = {shell = "docker compose -p {{ package_name }} run --rm app sh -c 'PYTHONPATH=/app/src:/app/.venv/lib/python3.12/site-packages python -m alembic upgrade head'"}
migrate = "alembic upgrade head"
pdm_sync = "pdm sync --skip post_install"

deploy = {composite = ["backup", "pdm_sync", "er", "client_install", "build", "dc_build", "dc_migrate", "dc_up"]}
er = "pdm export -f requirements -G test --without-hashes -o requirements.txt"

ci = {composite = ["pdm_sync", "test", "deploy"]}

prod = "uvicorn {{ package_name }}.app:app --host 0.0.0.0 --port {{ port }}"

install_test = "pdm sync -G dev"
run_tests = "pytest -v --cov={{ package_name }} --cov-report=term-missing"
test = {composite = ["install_test", "run_tests"]}
test_watch = "pytest -v --cov={{ package_name }} --cov-report=term-missing --watch"

{%- if include_e2e %}
e2e = "playwright test"
e2e_install = "playwright install --with-deps"
{%- endif %}

expand_macros = {shell = "python src/scripts/expand_macros.py src/"}
format = {shell = "djhtml src/"}

watch = "bun run watch"

[tool.pytest.ini_options]
asyncio_mode = "auto"
testpaths = ["tests"]

[tool.pdm]
distribution = true

[dependency-groups]
dev = [
  "python-dotenv>=1.2.2",
  "pytest>=8.0",
  "pytest-asyncio>=0.23",
  "pytest-cov>=5.0",
  "pytest-watch>=4.2",
  "ruff>=0.11.0",
  "djhtml>=3.0.11",
  "djlint>=1.36.4",
  {%- if include_e2e %}
  "playwright>=1.40",
  "pytest-playwright>=0.4.4",
  {%- endif %}
]

[tool.ruff]
line-length = 100
target-version = "py312"

[tool.ruff.lint]
ignore = ["E501"]
select = ["E", "F", "I", "N", "W", "UP"]

[tool.djlint]
extend-exclude = "*.md"
extensions = "html,jinja,jinja2,j2"
ignore = "H006,H013,H005,H014,H023"
profile = "jinja"

[tool.jinja-lsp]
backend = ["./src"]
templates = "./src"

[tool.live-jinja-renderer.templates]
filePatterns = ["**/*.html"]
searchPaths = [
  "src/{{ package_name }}",
]

[tool.ruff.per-file-ignores]
"src/{{ package_name }}/migrations/env.py" = ["I001", "F401"]

[tool.ruff.lint.isort]
force-single-line = false